{
  "$defs": {
    "Application": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Application Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "application_id",
        "snapshot_id"
      ],
      "title": "Application",
      "type": "object"
    },
    "Member": {
      "additionalProperties": false,
      "properties": {
        "available_minutes": {
          "anyOf": [
            {
              "maximum": 44640,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available Minutes"
        },
        "can_own": {
          "title": "Can Own",
          "type": "boolean"
        },
        "can_verify": {
          "title": "Can Verify",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "can_own",
        "can_verify",
        "available_minutes"
      ],
      "title": "Member",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Id",
          "type": "string"
        },
        "kr_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Kr Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kr_id"
      ],
      "title": "Project",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "cycle",
            "kr",
            "month",
            "week",
            "task",
            "evidence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "content_hash"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Actor Id",
          "type": "string"
        },
        "team_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Team Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "team_id",
        "actor_id"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Constraints",
          "type": "array"
        },
        "cycle_ref": {
          "$ref": "#/$defs/Ref"
        },
        "kr_ref": {
          "$ref": "#/$defs/Ref"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/Member"
          },
          "maxItems": 100,
          "title": "Members",
          "type": "array"
        },
        "parent_confirmed": {
          "const": true,
          "title": "Parent Confirmed",
          "type": "boolean"
        },
        "parent_ref": {
          "$ref": "#/$defs/Ref"
        },
        "parent_window": {
          "$ref": "#/$defs/Window"
        },
        "projects": {
          "items": {
            "$ref": "#/$defs/Project"
          },
          "maxItems": 100,
          "title": "Projects",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 200,
          "minItems": 2,
          "title": "Sources",
          "type": "array"
        },
        "target_window": {
          "$ref": "#/$defs/Window"
        },
        "timezone": {
          "const": "Asia/Shanghai",
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "cycle_ref",
        "kr_ref",
        "parent_ref",
        "parent_confirmed",
        "parent_window",
        "target_window",
        "timezone",
        "sources",
        "members",
        "projects",
        "constraints"
      ],
      "title": "Snapshot",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "title",
        "text"
      ],
      "title": "Source",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "ends_on": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Ends On",
          "type": "string"
        },
        "level": {
          "enum": [
            "quarter",
            "month",
            "week",
            "day"
          ],
          "title": "Level",
          "type": "string"
        },
        "period_key": {
          "maxLength": 10,
          "minLength": 6,
          "title": "Period Key",
          "type": "string"
        },
        "starts_on": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Starts On",
          "type": "string"
        }
      },
      "required": [
        "level",
        "period_key",
        "starts_on",
        "ends_on"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "application": {
      "$ref": "#/$defs/Application"
    },
    "input": {
      "$ref": "#/$defs/Snapshot"
    },
    "input_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Snapshot Hash",
      "type": "string"
    },
    "intent_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Intent Id",
      "type": "string"
    },
    "schema_version": {
      "const": "pb.okr.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "task_kind": {
      "enum": [
        "plan.decompose",
        "task.suggest",
        "progress.review"
      ],
      "title": "Task Kind",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_kind",
    "intent_id",
    "scope",
    "application",
    "input",
    "input_snapshot_hash"
  ],
  "title": "Request",
  "type": "object"
}
