{
  "$defs": {
    "Application": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Application Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "application_id",
        "snapshot_id"
      ],
      "title": "Application",
      "type": "object"
    },
    "Attempt": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Id",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "state": {
          "enum": [
            "succeeded",
            "failed",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "id",
        "model",
        "state",
        "usage"
      ],
      "title": "Attempt",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Actor Id",
          "type": "string"
        },
        "team_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Team Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "team_id",
        "actor_id"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        }
      },
      "required": [
        "completeness",
        "input_tokens",
        "output_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "application": {
      "$ref": "#/$defs/Application"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/Attempt"
      },
      "maxItems": 100,
      "title": "Attempts",
      "type": "array"
    },
    "attempts_complete": {
      "title": "Attempts Complete",
      "type": "boolean"
    },
    "input_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Snapshot Hash",
      "type": "string"
    },
    "intent_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Intent Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "pb.okr.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "timed_out",
        "cancelled",
        "interrupted"
      ],
      "title": "State",
      "type": "string"
    },
    "task_kind": {
      "enum": [
        "plan.decompose",
        "task.suggest",
        "progress.review"
      ],
      "title": "Task Kind",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "intent_id",
    "task_kind",
    "input_snapshot_hash",
    "scope",
    "application",
    "state",
    "attempts_complete",
    "attempts"
  ],
  "title": "RuntimeReceipt",
  "type": "object"
}
